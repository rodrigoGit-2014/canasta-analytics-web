# API URLs — injected at build time by Vite (VITE_ prefix required)
# For local development these are not needed (vite proxy handles routing)
# For Railway/production, set these to the deployed backend URLs
VITE_SALES_API_URL=https://<sales-service>.railway.app/api/v1
VITE_APRIORI_API_URL=https://<apriori-service>.railway.app/api/v1
